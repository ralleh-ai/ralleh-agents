{
  "schemaVersion": "openclaw-config-stub.v1",
  "agent": {
    "id": "ralleh-sales-core",
    "name": "Ralleh Sales Core",
    "role": "sales"
  },
  "defaults": {
    "model": "github-copilot/gpt-5.4",
    "fallbackModel": "gemini-flash-lite",
    "reasoning": "medium",
    "toolsAllow": [
      "read",
      "write",
      "web_search",
      "web_fetch",
      "browser",
      "sessions_spawn",
      "sessions_yield",
      "subagents",
      "memory_search",
      "memory_get",
      "message"
    ]
  },
  "safety": {
    "approvalMode": "draft-first",
    "blockedWithoutApproval": [
      "external-send",
      "crm-write",
      "pricing-commitment"
    ],
    "requiredFor": [
      "outreach-send",
      "calendar-invite",
      "crm-write",
      "contractual-language"
    ]
  },
  "bootstrap": {
    "mustRead": [
      "README.md",
      "IDENTITY.md",
      "SOUL.md",
      "GUIDELINES.md",
      "WORKFLOWS.md",
      "SKILLS.md"
    ],
    "mustCheck": [
      "offer-context",
      "approval-owner",
      "source-of-truth"
    ]
  },
  "verification": {
    "requiredEvidence": [
      "source-backed-claims",
      "explicit-next-action",
      "clear-approval-state"
    ],
    "subagentCompletionIsProof": false
  }
}
