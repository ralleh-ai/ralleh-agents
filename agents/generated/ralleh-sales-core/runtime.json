{
  "id": "sales-core",
  "name": "Sales Core Runtime Profile",
  "modelProfile": {
    "defaultModelClass": "clear-writer",
    "escalationModelClass": "strong-reasoning",
    "simpleTaskModelClass": "fast-efficient"
  },
  "toolProfile": {
    "policy": "least-privilege",
    "allowedCategories": [
      "documents",
      "research",
      "browser",
      "task-ledger",
      "memory",
      "calendar"
    ],
    "notes": "External sends and CRM writes require explicit approval."
  },
  "approvalProfile": {
    "defaultMode": "draft-first",
    "alwaysConfirm": [
      "external-sends",
      "crm-writes",
      "pricing-promises",
      "contractual-commitments"
    ],
    "allowWithoutApproval": [
      "drafting",
      "qualification",
      "pipeline-analysis"
    ]
  },
  "bootstrapProfile": {
    "mustRead": [
      "README.md",
      "IDENTITY.md",
      "SOUL.md",
      "GUIDELINES.md",
      "WORKFLOWS.md",
      "SKILLS.md"
    ],
    "mustCheck": [
      "offer-context",
      "approval-owner",
      "source-of-truth"
    ]
  }
}
