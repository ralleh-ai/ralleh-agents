{
  "schemaVersion": "openclaw-agent-manifest.v1",
  "agent": {
    "id": "ralleh-sales-core",
    "name": "Ralleh Sales Core",
    "role": "sales",
    "skills": [
      "LinkedInManager",
      "GoogleSheets",
      "CalendarScheduler",
      "Gog",
      "Office365Connector",
      "AgentBrowser",
      "Cortex",
      "OperatingProtocol"
    ]
  },
  "openclaw": {
    "bootstrap": {
      "mustRead": [
        "README.md",
        "IDENTITY.md",
        "SOUL.md",
        "GUIDELINES.md",
        "WORKFLOWS.md",
        "SKILLS.md"
      ],
      "mustCheck": [
        "offer-context",
        "approval-owner",
        "source-of-truth"
      ]
    },
    "models": {
      "primaryClass": "clear-writer",
      "fallbackClass": "fast-efficient",
      "specialistClass": "strong-reasoning",
      "defaultReasoning": "medium"
    },
    "tools": {
      "categories": [
        "documents",
        "research",
        "browser",
        "task-ledger",
        "memory",
        "calendar"
      ],
      "policy": "least-privilege",
      "allowedModes": [
        "read",
        "draft",
        "qualify",
        "summarize",
        "delegate"
      ],
      "blockedWithoutApproval": [
        "external-send",
        "crm-write",
        "pricing-commitment"
      ]
    },
    "approvals": {
      "mode": "draft-first",
      "alwaysConfirm": [
        "external-sends",
        "crm-writes",
        "pricing-promises",
        "contractual-commitments"
      ],
      "allowWithoutApproval": [
        "drafting",
        "qualification",
        "pipeline-analysis"
      ],
      "requiredFor": [
        "outreach-send",
        "calendar-invite",
        "crm-write",
        "contractual-language"
      ],
      "notRequiredFor": [
        "drafting",
        "qualification",
        "pipeline-analysis"
      ]
    },
    "verification": {
      "requiredEvidence": [
        "source-backed-claims",
        "explicit-next-action",
        "clear-approval-state"
      ],
      "subagentCompletionIsProof": false
    }
  }
}
