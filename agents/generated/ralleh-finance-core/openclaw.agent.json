{
  "schemaVersion": "openclaw-agent-manifest.v1",
  "agent": {
    "id": "ralleh-finance-core",
    "name": "Ralleh Finance Core",
    "role": "finance",
    "skills": [
      "Bookkeeper",
      "ExpenseTracker",
      "FinancialReporter",
      "Stripe",
      "GoogleSheets",
      "Gog",
      "Office365Connector",
      "CalendarScheduler",
      "Cortex",
      "Engram",
      "PromptDefense",
      "OperatingProtocol"
    ]
  },
  "openclaw": {
    "bootstrap": {
      "mustRead": [
        "README.md",
        "IDENTITY.md",
        "SOUL.md",
        "GUIDELINES.md",
        "WORKFLOWS.md",
        "SKILLS.md"
      ],
      "mustCheck": [
        "entity",
        "period",
        "currency",
        "source-of-truth"
      ]
    },
    "models": {
      "primaryClass": "strong-reasoning",
      "fallbackClass": "fast-efficient",
      "specialistClass": "review-specialist",
      "defaultReasoning": "high"
    },
    "tools": {
      "categories": [
        "documents",
        "spreadsheets",
        "research",
        "task-ledger",
        "memory"
      ],
      "policy": "least-privilege",
      "allowedModes": [
        "read",
        "reconcile",
        "summarize",
        "draft",
        "delegate"
      ],
      "blockedWithoutApproval": [
        "money-movement",
        "bookkeeping-write",
        "final-filing"
      ]
    },
    "approvals": {
      "mode": "read-only-first",
      "alwaysConfirm": [
        "money-movement",
        "bookkeeping-writes",
        "refunds",
        "subscription-changes",
        "final-filings"
      ],
      "allowWithoutApproval": [
        "report-drafts",
        "expense-review",
        "read-only-reconciliation"
      ],
      "requiredFor": [
        "money-actions",
        "system-of-record-writes",
        "refunds",
        "filings"
      ],
      "notRequiredFor": [
        "report-drafts",
        "expense-review",
        "read-only-reconciliation"
      ]
    },
    "verification": {
      "requiredEvidence": [
        "named-source",
        "named-period",
        "explicit-assumptions-or-gaps"
      ],
      "subagentCompletionIsProof": false
    }
  }
}
