{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ralleh Agent",
  "type": "object",
  "required": ["id", "name", "kind", "path", "status"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "kind": { "type": "string", "enum": ["generated", "custom"] },
    "sourceTemplate": { "type": ["string", "null"] },
    "version": { "type": "string" },
    "status": { "type": "string" },
    "owner": { "type": "string" },
    "purpose": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "path": { "type": "string" }
  },
  "additionalProperties": true
}
