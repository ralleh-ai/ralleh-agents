{
  "name": "ralleh-agents",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "validate": "npm run build && node dist/cli/validate-registry.js",
    "generate": "npm run build && node dist/cli/new-agent.js",
    "promote": "npm run build && node dist/cli/promote-agent.js",
    "audit:roles": "npm run build && node dist/cli/audit-roles.js",
    "audit:roles:report": "npm run build && node dist/cli/audit-roles.js",
    "audit:runtime": "npm run build && node dist/cli/validate-registry.js && node dist/cli/audit-roles.js",
    "phase7:check": "npm run build && node dist/cli/validate-registry.js && node dist/cli/audit-roles.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
